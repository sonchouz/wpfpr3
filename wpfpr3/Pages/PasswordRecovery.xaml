<Page x:Class="wpfpr3.Pages.PasswordRecovery"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wpfpr3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PasswordRecovery" Background="White">

    <Grid>
        <Border Background="#F5F5F5"
                CornerRadius="10"
                Padding="20"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Новый пароль"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Введите новый пароль"/>
                <PasswordBox x:Name="pbNewPassword" Height="30" Margin="0,5,0,10"/>

                <TextBlock Text="Повторите новый пароль"/>
                <PasswordBox x:Name="pbRepeatPassword" Height="30" Margin="0,5,0,10"/>

                <Button Content="Сохранить новый пароль"
                        Height="34"
                        Margin="0,10,0,0"
                        Click="btnSaveNewPassword_Click"/>

                <TextBlock x:Name="tbStatus"
                           Foreground="Red"
                           TextAlignment="Center"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
