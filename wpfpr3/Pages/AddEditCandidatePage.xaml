<Page x:Class="wpfpr3.Pages.AddEditCandidatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditCandidatePage" Background="White">

    <Grid>
        <ScrollViewer Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <TextBlock Text="Фамилия:" />
                    <TextBox x:Name="txtSurname"
                             Text="{Binding User.surname, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AnyField_TextChanged"/>

                    <TextBlock Text="Имя:" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtfirstname"
                             Text="{Binding User.firstname, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AnyField_TextChanged"/>

                    <TextBlock Text="Телефон:" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtPhone"
                             Text="{Binding User.phone, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="Phone_PreviewTextInput"
                             TextChanged="AnyField_TextChanged"/>

                    <TextBlock Text="Образование:" Margin="0,10,0,0"/>
                    <ComboBox x:Name="cmbEdu"
                                 ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=DataContext.Education}" 
          DisplayMemberPath="edulevel"
          SelectedValuePath="id"
          SelectedValue="{Binding educationID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Дата рождения:" Margin="0,10,0,0"/>
                    <DatePicker x:Name="dpBirthday"
                                SelectedDate="{Binding User.birthday, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Email:" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtEmail"
                             Text="{Binding User.email, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AnyField_TextChanged"/>

                    <TextBlock Text="Гражданство:" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtCitizenship"
                             Text="{Binding citizenship, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AnyField_TextChanged"/>

                    <TextBlock Text="Город проживания:" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtCity"
                             Text="{Binding livingcity, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AnyField_TextChanged"/>

                    <TextBlock Text="Пароль:" Margin="0,10,0,0"/>
     
                    <TextBox x:Name="txtPswd"
                              Text="{Binding User.hashpass, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AnyField_TextChanged"/>

                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                    <Image x:Name="img"
                           Width="120"
                           Height="120"
                           Stretch="UniformToFill"
                           Source="/wpfpr3;component/Resources/сотрудник.png" />

                    <Button Content="Выбрать изображение"
                            Margin="0,10,0,0"
                            Click="btnEnterImage_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,30,0,0">

                        <Button x:Name="btnSaveCand"
                                Content="Сохранить"
                                Width="160"
                                Margin="0,0,10,0"
                                Click="btnSaveCandidate_Click" />

                        <Button x:Name="btnDeleteCand"
                                Content="Удалить"
                                Width="160"
                                Visibility="Collapsed"
                                Click="btnDeleteCandidate_Click" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
