<Page x:Class="wpfpr3.Pages.ForgotPassword"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wpfpr3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ForgotPassword" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин: "/>
            <TextBox x:Name="txtbLogin"/>
            <TextBlock Visibility="Hidden" x:Name="txtBlockCode" Text="Код:"/>
            <TextBox Visibility="Hidden" x:Name="txtbCode"/>

            <StackPanel Orientation="Horizontal" Height="80" HorizontalAlignment="Center">
                <Button x:Name="btnConfirm" Margin="5,15,5,5" Content="Подтвердить" Click="btnConfirm_Click"/>
                

            </StackPanel>
        </StackPanel>
    </Grid>
    
    
</Page>
