<Page x:Class="wpfpr3.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wpfpr3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Autho" Background="White">

    <Grid Margin="0,0,10,-75">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин: "/>
            <TextBox x:Name="txtbLogin"/>
            <TextBlock Text="Пароль: "/>
            <TextBox x:Name="txtbPassword"/>
            <TextBlock Visibility="Hidden" x:Name="txtBlockCaptcha" Text="Капча:"/>
            <TextBox Visibility="Hidden" x:Name="txtbCaptcha"/>
            <TextBlock x:Name="Timetxt" Visibility="Hidden"/>


            <TextBlock HorizontalAlignment="Center" Visibility="Hidden" x:Name="txtBlockTimer"/>

            <StackPanel Orientation="Horizontal" Height="80" HorizontalAlignment="Center">
                <Button x:Name="btnEnterGuests" Margin="5,15,5,5" Content="Войти как гость" Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Margin="5,15,5,5" Content="Войти" Click="btnEnter_Click"/>

            </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="Забыли пароль?" HorizontalAlignment="Center" Margin="0,391,0,0" VerticalAlignment="Top" Click="forgotButton_Click" Height="34" Width="170"/>

        <Border x:Name="RecoveryPanel"
        Grid.Column="1"
        Margin="0,20,0,0"
        Padding="20"
        Background="#F5F5F5"
        CornerRadius="8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        MinWidth="450"
        MaxWidth="800"
        Visibility="Collapsed">

            <StackPanel>

                <TextBlock Text="Восстановление пароля"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"/>

                <TextBlock Text="Введите логин или почту"
                   TextWrapping="Wrap"/>

                <TextBox x:Name="tbRecoverLogin"
                 Margin="0,5,0,10"
                 Height="28"
                 HorizontalAlignment="Stretch"/>

                <Button Content="Отправить код"
                Height="30"
                Margin="0,5,0,10"
                HorizontalAlignment="Stretch"
                Click="btnSendCode_Click"/>

                <TextBlock Text="Введите код из письма"
                   TextWrapping="Wrap"/>

                <TextBox x:Name="tbCode"
                 Margin="0,5,0,10"
                 Height="28"
                 HorizontalAlignment="Stretch"/>

                <Button Content="Подтвердить"
                Height="30"
                Margin="0,5,0,10"
                HorizontalAlignment="Stretch"
                Click="btnConfirm_Click"/>

                <TextBlock x:Name="tbRecoverStatus"
                   Foreground="Red"
                   TextAlignment="Center"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

            </StackPanel>
        </Border>
        <Border x:Name="TwoFactorPanel"
        Grid.Column="1"
        Margin="0,20,0,0"
        Padding="20"
        Background="#F5F5F5"
        CornerRadius="8"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Width="420"
        Visibility="Collapsed">

            <StackPanel>
                <TextBlock Text="Подтверждение входа"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

                <TextBlock Text="Мы отправили 4-значный код на вашу почту."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

                <TextBlock Text="Введите код"/>
                <TextBox x:Name="tbTwoFactorCode" Height="28" Margin="0,5,0,10"/>

                <Button Content="Подтвердить"
                Height="30"
                Click="btnTwoFactorConfirm_Click"/>

                <TextBlock x:Name="tbTwoFactorStatus"
                   Foreground="Red"
                   TextAlignment="Center"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </Grid>
    
</Page>
