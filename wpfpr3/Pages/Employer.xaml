<Page x:Class="wpfpr3.Pages.Employer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:wpfpr3.Pages"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      Title="Employer"
      Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Поиск по фамилии:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,10"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="txtFullName"
                 Grid.Row="1"
                 Grid.Column="0"
                 Margin="0,0,10,10"
                 Height="30"
                 VerticalContentAlignment="Center"
                 TextChanged="txtFullName_TextChanged" />

        <ComboBox x:Name="cmbSorting"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,10,10"
                  Height="30"
                  ItemsSource="{Binding SortingList}"
                  SelectedIndex="0"
                  SelectionChanged="cmbSorting_SelectionChanged" />

        <ComboBox x:Name="cmbFilter"
                  Grid.Row="1"
                  Grid.Column="2"
                  Margin="0,0,10,10"
                  Height="30"
                  ItemsSource="{Binding FilterList}"
                  SelectedIndex="0"
                  SelectionChanged="cmbFilter_SelectionChanged" />

        <StackPanel Grid.Row="1"
                    Grid.Column="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,0,10">
            <TextBlock x:Name="txtResultCount" Margin="0,0,5,0"/>
            <TextBlock Text="из" Margin="0,0,5,0"/>
            <TextBlock x:Name="txtAllAmount"/>
        </StackPanel>

        <!-- Основная область -->
        <FlowDocumentReader x:Name="fdr"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Margin="0,10,0,10"
                            ViewingMode="Scroll">

            <FlowDocument PagePadding="40"
                          ColumnWidth="Auto"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          IsOptimalParagraphEnabled="True"
              IsHyphenationEnabled="True">

                <Paragraph FontSize="18" FontWeight="Bold" Margin="0,0,0,15">
                    Список сотрудников
                </Paragraph>

                <BlockUIContainer>
                    <ListView x:Name="lViewCand"
                              ItemsSource="{Binding}"
                              MouseDoubleClick="lViewCand_MouseDoubleClick"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D0D0D0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Колонка 1 -->
                                        <StackPanel Grid.Column="0" Margin="5">
                                            <TextBlock Text="{Binding User.firstname}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding User.surname}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding User.roleID, StringFormat=Роль: {0}}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Колонка 2 -->
                                        <StackPanel Grid.Column="1" Margin="5">
                                            <TextBlock Text="{Binding User.birthday, StringFormat=Дата рождения: {0:dd.MM.yyyy}}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding User.email, StringFormat=Email: {0}}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding citizenship, StringFormat=Гражданство: {0}}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Колонка 3 -->
                                        <StackPanel Grid.Column="2" Margin="5">
                                            <TextBlock Text="{Binding Education.edulevel, StringFormat=Образование: {0}}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding livingcity, StringFormat=Город: {0}}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding User.phone, StringFormat=Телефон: {0}}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.ContextMenu>
                            <ContextMenu x:Name="contextMenu">
                                <MenuItem x:Name="btnAddEmp"
                                          Header="Добавить сотрудника"
                                          Click="btnAddEmp_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </BlockUIContainer>
            </FlowDocument>
        </FlowDocumentReader>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0">

            <Button x:Name="PrintListbtn"
                    Content="Печать списка"
                    Width="150"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="PrintListButton_Click"/>

            <Button x:Name="btnEmp"
                    Content="Сотрудник"
                    Visibility="Collapsed"
                    Width="200"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="btnEmp_Click"/>

            <Button x:Name="btnAddNewEmp"
                    Content="Добавить сотрудника"
                    Width="200"
                    Height="35"
                    Click="btnAddNewEmp_Click"/>
        </StackPanel>
    </Grid>
</Page>